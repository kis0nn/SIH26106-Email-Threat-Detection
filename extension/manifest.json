{
  "manifest_version": 3,
  "name": "SIH26106 Email Threat Forensics",
  "version": "2.0.0",
  "description": "1-click phishing, brand impersonation and spoofing scanner directly in Gmail.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:8000/*",
    "https://*.onrender.com/*"
  ],
  "action": {
    "default_title": "SIH26106 Threat Scanner",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
